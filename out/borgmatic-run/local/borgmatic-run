#!/bin/zsh
# Scheduled/manual driver for the home borg backup. Each repository is run on
# its own, so the drive being unplugged doesn't hold back the storage box.
# Triggers: launchd StartCalendarInterval (13:00), StartOnMount, RunAtLoad.
# The 12h throttle keeps the extra triggers cheap; --force bypasses it.

# launchd hands us a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin). borgmatic
# shells out to `borg` by name, so Homebrew's bin must be on PATH or the job
# dies with "No such file or directory: 'borg'".
export PATH="/opt/homebrew/bin:$PATH"

# Labels and paths as in borgmatic's config
REPOS=(elements storagebox)
typeset -A LOCATION=(
  elements   "/Volumes/Elements SE/borg/home"
  storagebox "ssh://storage/./mac-home"
)
STATE="$HOME/.local/state"
MIN_INTERVAL=$(( 12 * 3600 ))
mkdir -p "$STATE"

# Capture this BEFORE the tee redirect below, because once stdout is a pipe
# `[[ -t 1 ]]` is false and the verbosity choice further down would break.
INTERACTIVE=0
[[ -t 1 ]] && INTERACTIVE=1

# launchd already redirects our stdout into this log. Interactive runs (`bb`)
# would otherwise leave no trace, making `bs`'s log tail disagree with its own
# "last success" line - so tee them in too.
LOG="$HOME/Library/Logs/borgmatic.log"
if (( INTERACTIVE )); then
  exec > >(tee -a "$LOG") 2>&1
fi
echo "$(date '+%F %T') --- run start ---"

# StartOnMount can fire an automatic run right as `bb` is typed by hand, and
# both would otherwise race for borg's own repo lock - the loser fails with
# a lock timeout instead of just waiting its turn. Guard with our own lock,
# one per repository so a long upload doesn't block the drive.
HELD=""
trap '[[ -n "$HELD" ]] && rm -rf "$HELD"' EXIT
acquire() {
  local lock="$STATE/borgmatic-run-$1.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    OTHER_PID=$(<"$lock/pid" 2>/dev/null)
    [[ -n "$OTHER_PID" ]] && kill -0 "$OTHER_PID" 2>/dev/null && return 1
    rm -rf "$lock"
    mkdir "$lock"
  fi
  echo $$ > "$lock/pid"
  HELD="$lock"
}
release() {
  rm -rf "$HELD"
  HELD=""
}

age() {   # seconds since the stamp's last success; huge if never
  if [[ -f "$1" ]]; then echo $(( $(date +%s) - $(<"$1") )); else echo 999999999; fi
}

available() {
  case "$1" in
    elements) [[ -d "$LOCATION[elements]" ]] ;;
    # same ssh options as borgmatic's ssh_command
    storagebox) ssh -o IdentityAgent=none -o IdentitiesOnly=yes -o IdentityFile=~/.ssh/storage \
                    -o BatchMode=yes -o ConnectTimeout=10 storage df >/dev/null 2>&1 ;;
  esac
}

FORCE=0
[[ "$1" == "--force" || "$1" == "-f" ]] && FORCE=1

# Interactive (`bb`) wants to see progress; launchd wants a quiet log it can be
# grepped later. Pick by whether stdout is a terminal.
if (( INTERACTIVE )); then
  ARGS=(--verbosity 1)
  STATS=(--stats)
else
  ARGS=(--verbosity 0 --syslog-verbosity 1)
  STATS=()
fi

# The ping URL is a secret and this repo is public, so it lives in the
# keychain. No entry means no pings. We ping ourselves rather than through
# borgmatic, since one check has to cover every repository.
HC_URL=$(security find-generic-password -a samuelraub -s borg-healthchecks -w 2>/dev/null)
hc_ping() {
  [[ -n "$HC_URL" ]] && curl -fsS -m 10 --retry 3 -o /dev/null "${HC_URL%/}$1"
}

worst=0
ran=0
stale=0
for label in $REPOS; do
  stamp="$STATE/borgmatic-last-success-$label"

  if (( ! FORCE )) && (( $(age "$stamp") < MIN_INTERVAL )); then
    echo "$(date '+%F %T') $label: last success $(age "$stamp")s ago - skipping"
    continue
  fi

  if ! acquire "$label"; then
    echo "$(date '+%F %T') $label: another run (pid $OTHER_PID) is already in progress - skipping"
    stale=1
    continue
  fi

  if ! available "$label"; then
    echo "$(date '+%F %T') $label: not reachable - skipping"
    stale=1
    release
    continue
  fi

  # We hold the run lock, so a borg lock is stale unless something else on
  # this host (a manual borg, `bs`) has the repository open right now.
  if ! pgrep -f -- "$LOCATION[$label]" >/dev/null; then
    /opt/homebrew/bin/borgmatic --verbosity 0 break-lock --repository "$label"
  fi

  # --repository only exists per action, so spell out the default actions
  START=$(date +%s)
  /usr/bin/caffeinate -i -m -s /opt/homebrew/bin/borgmatic "${ARGS[@]}" \
    create --repository "$label" "${STATS[@]}" \
    prune --repository "$label" "${STATS[@]}" \
    compact --repository "$label" \
    check --repository "$label"
  rc=$?
  ran=1

  if (( rc == 0 )); then
    date +%s > "$stamp"
    echo "$(date '+%F %T') $label: run finished ok, took $(( $(date +%s) - START ))s"
  else
    echo "$(date '+%F %T') $label: borgmatic exited $rc"
    (( rc > worst )) && worst=$rc
  fi
  release
done

# Green only while every repository is fresh: one that was skipped as
# unreachable or busy just withholds the success ping, so the check times out
# on its own schedule.
if (( worst )); then
  hc_ping /fail
elif (( ran && ! stale )); then
  hc_ping ""
fi

exit $worst
