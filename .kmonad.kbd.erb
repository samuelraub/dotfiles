(deflayer sym
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    S-[  S-7  S-8  S-/  S-]  _    XX   XX   XX   XX   XX   _    _
  _    S-;  S-4  S-5  S-6  S-=  _    XX   rmet ralt rctl rsft _    _
  _    S-`  S-1  S-2  S-3  S-\  _    XX   XX   XX   XX   XX   _
  _    _    _    S-9  S-0  S--  _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer num
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    [    7    8    9    ]    _    XX   XX   XX   XX   XX   _    _
  _    ;    4    5    6    =    _    XX   rmet ralt rctl rsft _    _
  _    `    1    2    3    \    _    XX   XX   ,    .    /    _
  _    _    _    _    0    -    _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
