(defcfg
  input  (iokit-name "Apple Internal Keyboard / Trackpad")
  output (kext)
  fallthrough false
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up
  fn   lctl lalt lmet           spc            rmet ralt left down rght
)

(defalias
  a (tap-hold-next-release 280 a lsft)
  s (tap-hold-next-release 280 r lctl)
  d (tap-hold-next-release 280 s lalt)
  f (tap-hold-next-release 280 t lmet)
  j (tap-hold-next-release 280 n rmet)
  k (tap-hold-next-release 280 e ralt)
  l (tap-hold-next-release 280 i rctl)
  ; (tap-hold-next-release 280 o rsft)
  tm (tap-hold-next-release 200 bspc (layer-toggle tmx))
  vm (tap-hold-next-release 200 spc  (layer-toggle vim))
  cm (tap-hold-next-release 200 tab  (layer-toggle ctl))
  sm (tap-hold-next-release 200 ret  (layer-toggle sym))
  nm (tap-hold-next-release 200 esc  (layer-toggle num))

  ;; Outer right thumb: hold Hyper (Alfred's AppSwitcher), tap the leader
  hyp (around lctl (around lalt (around lsft lmet)))
  hy  (tap-hold-next 200 (layer-next ldr) @hyp)
  lc  (layer-next ldr-c)
  la  (layer-next ldr-a)
  ls  (layer-next ldr-s)

  ;; Summoning keys: Hyper+T focuses kitty, then the tmux prefix.
  ;; Explicit arounds: nested implicit ones are flaky in tap-macros before 0.4.5.
  ht (around lctl (around lalt (around lsft (around lmet t))))
  tp (tap-macro @ht P250 C-a)
  tc (tap-macro @ht P250 C-a c)
  tz (tap-macro @ht P250 C-a z)
  ty (tap-macro @ht P250 C-a y)
  ts (tap-macro @ht P250 C-a s)
  tv (tap-macro @ht P250 C-a v)
  ta (tap-macro @ht P250 C-a C-a)
  t1 (tap-macro @ht P250 C-a 1)
  t2 (tap-macro @ht P250 C-a 2)
  t3 (tap-macro @ht P250 C-a 3)
  t4 (tap-macro @ht P250 C-a 4)

  ena (layer-switch default)
  dis (layer-switch off)
)

(deflayer default
  _    brdn brup _    _    _    _    @dis _    _    mute vold volu
  _    q    w    f    p    b    _    j    l    u    y    '    _    _
  _    @a   @s   @d   @f   g    _    m    @j   @k   @l   @;   _    _
  _    z    x    c    d    v    _    k    h    ,    .    /    _
  _    _    _    @tm  @vm  @cm  @sm  @nm  @hy  _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer tmx
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    XX   XX   XX   XX   XX   _    @tc  @tz  @ty  @ts  @tv  _    _
  _    lsft lctl lalt lmet XX   _    @tp  C-left C-down C-up C-rght _ _
  _    XX   XX   XX   XX   XX   _    @ta  @t1  @t2  @t3  @t4  _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer vim
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    XX   XX   XX   XX   XX   _    M-z  M-v  M-c  M-x  M-S-z _   _
  _    lsft lctl lalt lmet XX   _    XX   left down up   rght _    _
  _    XX   XX   XX   XX   XX   _    XX   A-M-v pgdn pgup XX  _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer ctl
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    XX   XX   XX   XX   XX   _    mute vold volu brdn brup _    _
  _    XX   XX   XX   XX   XX   _    XX   XX   XX   XX   XX   _    _
  _    XX   XX   XX   XX   XX   _    XX   XX   XX   XX   XX   _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
